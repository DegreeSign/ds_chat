{
    "compilerOptions": {
        "target": "es2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "CommonJS",
        "moduleResolution": "node10",
        "types": ["node"],
        "strict": true,
        "declaration": true,
        "outDir": "dist",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
